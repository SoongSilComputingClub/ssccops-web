# Next.js 환경변수 예시 파일
# 실제 값을 채운 뒤 .env.local 로 복사해서 사용하세요 (.env* 파일은 git에 커밋되지 않습니다)
#   cp .env.example .env.local

### Supabase Auth ###
# Google OAuth 로그인(/login)과 라우트 가드(src/proxy.ts)가 실제로 참조합니다.
# ssccops-server 의 SUPABASE_URL 과 동일한 프로젝트를 가리켜야 하며, Supabase 대시보드에서
# Google 프로바이더 활성화 + Redirect URL(http://localhost:3000/auth/callback) 등록이 필요합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

### Backend API (ssccops-server) ###
# 현재 PoC는 entities/*/api 의 mock JSON으로 동작하며, 아래 변수를 아직 코드에서 참조하지
# 않습니다. ssccops-server 연동 시(엔티티 mock.json → 실제 API 클라이언트 교체) 사용할 값입니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

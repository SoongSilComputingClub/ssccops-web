# Next.js 환경변수 예시 파일
# 실제 값을 채운 뒤 .env.local 로 복사해서 사용하세요 (.env* 파일은 git에 커밋되지 않습니다)
#   cp .env.example .env.local

### Supabase Auth ###
# Google OAuth 로그인(/login)과 라우트 가드(src/middleware.ts)가 실제로 참조합니다.
# ssccops-server 의 SUPABASE_URL 과 동일한 프로젝트를 가리켜야 하며, Supabase 대시보드에서
# Google 프로바이더 활성화 + Redirect URL(http://localhost:3000/auth/callback) 등록이 필요합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

### Backend API (ssccops-server) ###
# shared/lib/api/client.ts 의 apiFetch()가 참조합니다. 값이 없으면 요청을 보내지 않고 즉시
# 실패하므로(예전에는 undefined/v1/... 로 나갔습니다) 로그인 직후 세션 조회부터 막힙니다.
# 도메인 화면 대부분은 아직 entities/*/api 의 mock JSON으로 동작하며, 현재 이 값을 실제로
# 쓰는 것은 GET /v1/auth/session 과 POST /v1/members/signup(회원 가입) 입니다.
# ssccops-server 의 frontend.url(CORS 허용 오리진)에 이 앱의 오리진이 등록돼 있어야 합니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Next.js 환경변수 예시 파일 (학술 공개 앱 · apps/lms · #169)
# 실제 값을 채운 뒤 .env.local 로 복사해서 사용하세요 (.env* 파일은 git에 커밋되지 않습니다)
#   cp .env.example .env.local
#
# 이 앱은 **전 화면이 로그인 필수**입니다 — 스터디장·회원이 자기 학술 활동(대시보드·회차·
# 출석·기획안)을 보는 앱이고, 익명으로 여는 화면이 없습니다. 그래서 apps/www와 달리 미들웨어
# 매처가 전 경로를 잡고(src/middleware.ts), 아래 값들은 모든 화면에 필요합니다.

### Backend API (ssccops-server) ###
# src/shared/api/client.ts 의 apiFetch()가 참조합니다. 베이스 URL은 어드민·www와 같은 서버입니다.
# 값이 없으면 요청을 보내지 않고 즉시 실패합니다(CLIENT_CONFIG_MISSING).
#
# 조회는 대부분 서버 컴포넌트(SSR)에서 일어나지만, 기획안 자동 저장·제출 같은 화면은 브라우저에서
# 직접 이 주소를 부릅니다. 그래서 서버의 CORS 허용 오리진에 이 앱의 오리진이 등록돼 있어야
# 합니다 — 등록이 없으면 응답을 받지 못해 CLIENT_NETWORK_ERROR 로 보이고, 증상이 '서버가 꺼진
# 것'과 같습니다.
# **빌드 타임에 인라인되므로 값을 바꾸면 개발 서버를 재시작해야** 반영됩니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

### Supabase Auth ###
# 로그인(구글 OAuth)과 세션 갱신(src/middleware.ts)이 참조합니다.
# **어드민·www와 같은 Supabase 프로젝트**를 가리켜야 합니다 — 같은 계정으로 로그인한 사람이
# ssccops-server 에서 같은 회원으로 식별되어야 하기 때문입니다.
#
# Redirect URLs 에 **이 앱의 오리진**을 따로 등록해야 합니다. 어드민·www 오리진만 등록돼
# 있으면 여기서 시작한 로그인이 그쪽 도메인에서 끝나고, 그쪽에는 PKCE code_verifier 쿠키가
# 없어 실패합니다(어드민이 ssccops#84 로 실제로 밟은 함정이고, 오리진이 셋으로 늘어 다시 밟기
# 쉽습니다). 예:
#   http://localhost:3002/auth/callback
#   https://lms.sscc.co.kr/auth/callback
#
# 등록값은 **쿼리까지 포함한 실제 URL 전체**와 맞아야 합니다. 그래서 로그인 버튼은 redirectTo 에
# 쿼리를 붙이지 않고 목적지를 쿠키로 넘깁니다(src/shared/lib/oauth-next.ts) — 여기에 쿼리를
# 다시 붙이면 위 등록값이 전부 어긋나므로 붙이지 마세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

### 어드민(가입 화면이 있는 곳) 오리진 ###
# 학술 공개 앱에는 신청(참여) 흐름이 없어(참여 신청은 시스템 폼 · 2026-08-28 확정) apps/www처럼
# 간편 가입 폼을 임베드하지 않습니다. 미가입(SIGNUP_REQUIRED) 사용자는 이 오리진의 /signup 으로
# 보냅니다(src/shared/config/routes.ts 의 signupUrl()).
#
# 비워 두면 링크 없이 안내 문구만 보여 줍니다 — 없는 화면으로 보내지 않기 위한 기본값입니다.
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3000

### 공유 링크 오리진 (www) ###
# 이 앱에서 발급하는 학술 공유 링크(/s/{token})의 오리진입니다.
# src/entities/share/api/share-links.ts 가 참조합니다.
#
# **이 앱의 오리진이 아닙니다.** 학술 링크는 부원에게 나가므로 착지를 apps/www 가 받습니다
# (ADR-0017 — 착지 앱은 발급하는 앱이 아니라 대상 종류가 정합니다). 그래서 여기에는 반드시
# **www 배포 주소**를 넣어야 합니다.
#
# 변수 이름이 '공개 폼'인 것은 ssccops#214 가 공개 폼을 위해 만든 변수를 그대로 쓰기
# 때문입니다 — 값이 같은 www 오리진이라 변수를 하나 더 두면 두 값이 갈릴 자리만 생깁니다.
# 이름이 쓰임새보다 좁아진 것은 남아 있는 빚이고, 바꾸려면 배포 시크릿을 함께 옮겨야 해서
# 별도로 다룹니다(ADR-0017).
#
# 비워 두면 공유 버튼이 "공개 링크 주소가 설정되지 않았습니다" 안내로 떨어집니다 — 죽은
# 주소를 복사해 주는 것보다 낫다고 보아 그렇게 두었습니다.
NEXT_PUBLIC_PUBLIC_FORM_ORIGIN=http://localhost:3001
